    "createBranch": "task-contract-required",
    "commit": "task-contract-required",
    "push": "denied",
    "merge": "denied",
    "deploy": "denied",
    "productionDatabase": "denied",
    "driveWriteback": "task-contract-required",
    "canonApproval": "denied",
    "releaseApproval": "denied",
    "publication": "denied",
    "manufacturing": "denied",
    "spending": "denied",
    "externalCommunication": "denied"
