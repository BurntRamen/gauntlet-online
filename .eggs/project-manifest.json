  "preview": {
    "required": true,
    "routes": ["/"],
    "readiness": [
      { "kind": "http", "target": "http://localhost:4173/" }
    ]
  },
  "outputs": [
    { "id": "client-build", "path": "client/dist", "kind": "build" },
    { "id": "review-evidence", "path": ".eggs/evidence", "kind": "review" }
