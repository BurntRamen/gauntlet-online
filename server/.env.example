PORT=4000
CLIENT_URL=http://localhost:3000
CLIENT_URLS=http://localhost:3001
ACCOUNT_DATA_FILE=./accounts.json
FACTION_STATS_DATA_FILE=./faction-stats.json
MATCH_DATA_FILE=./matches.json
ROOM_STATE_DATA_FILE=./rooms.json
ROOM_STATE_RECOVERY_ENABLED=true
ROOM_RECONNECT_GRACE_MS=600000
ROOM_LOBBY_TTL_MS=3600000
ROOM_COMPLETED_TTL_MS=900000
ROOM_SWEEP_INTERVAL_MS=30000
ACCOUNT_AUTH_SECRET=local-development-secret-change-me
ACCOUNT_SESSION_TTL_MS=604800000
# Gauntlet Admin has exactly two account slots, checked by authenticated ID.
# Simply defaults to the existing production ID. Pin local/test identities explicitly.
GAUNTLET_ADMIN_SIMPLY_ACCOUNT_ID=47d97ddb-65f9-4014-be92-9b677467d943
# Defaults to the verified production account. Explicit empty/invalid IDs deny the slot.
# Neither slot has a display-name fallback.
GAUNTLET_ADMIN_BURNT_RAMEN_ACCOUNT_ID=9a9dcf5c-1d3f-422e-b0eb-ca1a32a699e5
# Production defaults to GitHub. No persistent server volume is needed for content.
GAUNTLET_CONTENT_PROVIDER=github
# Server-only credential scoped to BurntRamen/gauntlet-online:
# Contents and Pull requests write; Checks and Commit statuses read.
# Never use a REACT_APP_ variable or commit a credential.
GAUNTLET_GITHUB_TOKEN=
# Optional local development provider: set GAUNTLET_CONTENT_PROVIDER=file.
# Development file storage defaults to ACCOUNT_DATA_FILE + .content.
GAUNTLET_CONTENT_DATA_DIR=
COLLECTOR_ENTITLEMENT_SECRET=
PUBLIC_CLIENT_URL=http://localhost:3000
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Preferred for new Supabase projects; either key name is supported.
SUPABASE_SECRET_KEY=
MATCH_ARCHIVE_BUCKET=gauntlet-match-archives
MATCH_ARCHIVE_REQUIRED=false
# Local development only; production archives belong in private object storage.
MATCH_ARCHIVE_DATA_DIR=
ACCOUNT_AVATAR_BUCKET=gauntlet-profile-images
# Local development only; production portraits belong in private object storage.
ACCOUNT_AVATAR_DATA_DIR=
PACK_PURCHASE_URL=
