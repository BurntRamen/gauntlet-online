{
  "name": "gauntlet-online",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "install:all": "npm --prefix server ci && npm --prefix client ci",
    "check:server": "node --check server/index.js",
    "test:server": "npm --prefix server test",
    "test:client": "npm --prefix client test -- --watchAll=false",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:install": "playwright install chromium",
    "test:e2e:usability": "playwright test --config=playwright.usability.config.js",
    "test:e2e:performance": "playwright test --config=playwright.performance.config.js",
    "test:qualification": "node --test scripts/babylon-experience-gate.test.js scripts/build-babylon-visual-comparison.test.js scripts/elevenlabs-assets.test.js scripts/prune-webgpu-build.test.js scripts/report-match-assets.test.js scripts/report-match-audio.test.js",
    "capture:babylon-review": "playwright test --config=playwright.visual-review.config.js",
    "compare:babylon-review": "node scripts/build-babylon-visual-comparison.js",
    "build:client": "npm --prefix client run build",
    "serve:client-build": "node scripts/serve-client-build.js",
    "check:bundle": "node scripts/check-build-budgets.js",
    "report:match-assets": "node scripts/report-match-assets.js",
    "report:match-audio": "node scripts/report-match-audio.js",
    "generate:match-icons": "node scripts/generate-match-icons.js",
    "generate:match-sfx": "node scripts/generate-match-sfx.js",
    "generate:basic-card-art": "node scripts/generate-basic-card-art.js",
    "assets:elevenlabs": "node scripts/elevenlabs-assets.js",
    "test:elevenlabs-assets": "node --test scripts/elevenlabs-assets.test.js",
    "prepare:experience-gate": "node scripts/prepare-babylon-qualification.js",
    "check:experience-gate": "node scripts/babylon-experience-gate.js",
    "check": "npm run check:server && npm run test:qualification && npm run test:server && npm run test:client && npm run build:client && npm run check:bundle"
  },
  "engines": {
    "node": ">=22 <25"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.62.0",
    "sharp": "^0.35.3",
    "socket.io-client": "^4.8.3"
  }
}
