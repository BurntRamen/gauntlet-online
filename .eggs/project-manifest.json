    { "provider": "github", "reference": "BurntRamen/gauntlet-online", "role": "source repository", "status": "verified" },
    { "provider": "local-runtime", "reference": "manifest-defined npm commands", "role": "validation and preview", "status": "verified" }
  ],
  "permissions": {
